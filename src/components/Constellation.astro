---
// Constellation: 首页装饰用的粒子连线背景。纯前端 Canvas，无第三方依赖。
// 仅在渲染本组件的页面（首页）加载。画布在 JS 里创建并 prepend 到 <body>，
// 作为 body 直接子节点 + z-index:-1，稳定位于正文之下、页面底色之上。
//
// 幂等：本 <script> 会被 Astro 内联进页面 HTML，在 ClientRouter（View Transitions）
// 无刷新导航时会重新执行。因此每次进入都先销毁上一份实例——
// 移除旧 canvas、解绑 resize/visibilitychange、取消 rAF，避免堆积与监听器泄漏。
---

<script>
  (() => {
    if (!document.body) return;

    // 把 body 视为带「特效实例句柄」的类型，便于幂等清理
    type Handle = { destroy(): void };
    type Body = HTMLElement & { __ogConstellation?: Handle };
    const body = document.body as Body;

    // 幂等：先销毁上一次实例（若有）
    if (body.__ogConstellation) {
      body.__ogConstellation.destroy();
    }

    // 「减少动效」不再画成完全静态，而是降速 + 降亮，仍保留轻微运动；
    // 既不让画面冻住，又尊重无障碍偏好。
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speedScale = reduce ? 0.35 : 1;
    const alphaScale = reduce ? 0.6 : 1;

    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    // getContext('2d') 在常规浏览器环境必返回非空；用非空断言让闭包内 ctx 收窄为非 null
    const ctx = canvas.getContext('2d')!;
    canvas.style.cssText =
      'position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;opacity:.55';
    body.prepend(canvas);

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, raf = 0;
    type Particle = { x: number; y: number; vx: number; vy: number };
    let nodes: Particle[] = [];
    const LINK = 132; // 连线距离阈值（px）

    // 颜色读 OpenGood 主题变量，暗/亮自适应
    const accent = () =>
      getComputedStyle(document.documentElement).getPropertyValue('--sl-color-accent').trim() ||
      '#1ae686';

    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // 节点数按视口面积缩放，封顶 34~90
      const count = Math.min(90, Math.max(34, Math.round((w * h) / 22000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
      }));
    }

    function frame() {
      ctx.clearRect(0, 0, w, h);
      const color = accent();
      // 移动 + 边缘反弹（reduce 时降速）
      for (const n of nodes) {
        n.x += n.vx * speedScale;
        n.y += n.vy * speedScale;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }
      // 连线（透明度随距离衰减；reduce 时整体再降）
      ctx.lineWidth = 1;
      ctx.strokeStyle = color;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d = Math.hypot(dx, dy);
          if (d < LINK) {
            ctx.globalAlpha = (1 - d / LINK) * 0.5 * alphaScale;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
      // 节点
      ctx.globalAlpha = 0.7 * alphaScale;
      ctx.fillStyle = color;
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }

    function onVisibility() {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else if (!raf) {
        raf = requestAnimationFrame(frame);
      }
    }

    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', onVisibility);
    raf = requestAnimationFrame(frame);

    // 暴露销毁句柄，供下次执行幂等清理
    body.__ogConstellation = {
      destroy() {
        cancelAnimationFrame(raf);
        raf = 0;
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', onVisibility);
        canvas.remove();
        delete body.__ogConstellation;
      },
    };
  })();
</script>
